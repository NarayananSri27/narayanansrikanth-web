# Supabase Configuration
# Obtain these from your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Designate the website owner email (used for Owner-only Admin dashboard access)
# This MUST match the Google account email address you sign in with
NEXT_PUBLIC_OWNER_EMAIL=narayanan.srikanth@example.com

# Service Role Key (Used strictly in server-side administrative route handlers or migrations)
# NEVER expose this to the browser or commit to git!
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# GoatCounter Analytics (Optional lightweight privacy-friendly analytics)
# e.g. "my-personal-site" if your URL is https://my-personal-site.goatcounter.com
NEXT_PUBLIC_GOATCOUNTER_CODE=
